# Site profile: reference cluster, 8x A100 40GB per node.
#
# The reproducibility record of how the published adapter was produced. Paths match the
# layout the original runs used, so the existing caches and venv on $SCRATCH are reused.
# Activate with `ln -s configs/site/cluster.env site.env` or `export SITE_ENV=...`.
#
# Every line only fills a gap: anything already set (non-empty) in your environment wins.
# NCCL_SOCKET_IFNAME / NCCL_IB_HCA reach every job, not just train2n; single-node NCCL
# stays on NVLink and ignores them.

# `return` stops scripts/env.sh too, so an unset $SCRATCH never yields paths like /huggingface.
if [ -z "${SCRATCH:-}" ]; then
  echo "error: SCRATCH not set (configs/site/cluster.env)" >&2
  return 1
fi

: "${SITE_ACCOUNT:=<account>}"
# 2-day cap; the production partition for train1n, train2n and eval. (`gpu-short` caps
# at 1 GPU and 1 job per user, so it cannot validate anything multi-GPU.)
: "${SITE_PARTITION:=gpu-a100}"

: "${SITE_WORK_DIR:=${SCRATCH}/vlm_finetuning}"
# The shared HF cache predates this project dir, hence not under SITE_WORK_DIR.
: "${HF_HOME:=${SCRATCH}/huggingface}"
# The repo lives in $HOME, a 10 GiB quota already ~95% full, and the venv is ~7 GB.
# $SCRATCH is purged: if the venv disappears, scripts/setup_env.sh rebuilds it
# byte-identically from uv.lock.
: "${UV_PROJECT_ENVIRONMENT:=${SITE_WORK_DIR}/venvs/vlm}"
: "${UV_CACHE_DIR:=${SITE_WORK_DIR}/.uv-cache}"

# Xet buffers aggressively in RAM and gets OOM-killed by the login-node cgroup
# (observed: SIGKILL / exit 137 mid-download). Plain HTTP is slower but survives.
: "${HF_HUB_DISABLE_XET:=1}"

# Single Mellanox HCA; mlx5_0 / ib0 were read off the nodes, not assumed.
# Bootstrap over IPoIB: without IFNAME NCCL can pick `ext` or `svc-eth` and the two nodes
# never find each other.
: "${NCCL_SOCKET_IFNAME:=ib0}"
: "${NCCL_IB_HCA:=mlx5_0}"
