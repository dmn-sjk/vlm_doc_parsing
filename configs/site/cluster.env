# Site profile: reference cluster, 8x A100 40GB per node.
#
# The profile the published adapter was trained with; paths match the existing $SCRATCH
# caches and venv. Activate with `ln -s configs/site/cluster.env site.env`.

# `return` stops scripts/env.sh too, so an unset $SCRATCH never yields paths like /huggingface.
if [ -z "${SCRATCH:-}" ]; then
  echo "error: SCRATCH not set (configs/site/cluster.env)" >&2
  return 1
fi

: "${SITE_ACCOUNT:=<account>}"
# 2-day cap; the production partition for train1n, train2n and eval. (`gpu-short` caps
# at 1 GPU and 1 job per user, so it cannot validate anything multi-GPU.)
: "${SITE_PARTITION:=gpu-a100}"

: "${SITE_WORK_DIR:=${SCRATCH}/vlm_finetuning}"
# The shared HF cache predates this project dir, hence not under SITE_WORK_DIR.
: "${HF_HOME:=${SCRATCH}/huggingface}"
# $HOME is a 10 GiB quota and the venv ~7 GB. $SCRATCH is purged; setup_env.sh rebuilds it.
: "${UV_PROJECT_ENVIRONMENT:=${SITE_WORK_DIR}/venvs/vlm}"
: "${UV_CACHE_DIR:=${SITE_WORK_DIR}/.uv-cache}"

# Xet buffers in RAM and the login-node cgroup kills it mid-download; plain HTTP survives.
: "${HF_HUB_DISABLE_XET:=1}"

# Without IFNAME NCCL can bootstrap over `ext` or `svc-eth` and the nodes never meet.
# Single-node jobs stay on NVLink and ignore both.
: "${NCCL_SOCKET_IFNAME:=ib0}"
: "${NCCL_IB_HCA:=mlx5_0}"
