# Site profile template. Copy to the repo root and edit:
#
#   cp configs/site/example.env site.env
#
# (or point SITE_ENV at a profile elsewhere). scripts/env.sh sources it with `set -a`.
# A profile describes the machine only.
#
# Write every line as `: "${VAR:=value}"` (precedence: see scripts/env.sh). To abort loading (e.g. a missing prerequisite), `return 1`.
# Only the profile's last command decides whether it loaded, so end any command that may
# fail (e.g. `module load`) with `|| return 1`. Everything below is optional; unset values
# fall back to the defaults in scripts/env.sh or are left to the tool's own detection.

# SLURM (omit on clusters with a default account/partition, or on a workstation)
# Account to charge (sbatch -A).
# : "${SITE_ACCOUNT:=my-account}"
# Partition for train1n, train2n and eval (sbatch -p).
# : "${SITE_PARTITION:=gpu}"

# Storage
# Root for runs, adapters and caches. Default: <repo>/.work. Put it on fast, large storage.
# : "${SITE_WORK_DIR:=/scratch/$USER/vlm_finetuning}"
# Hugging Face cache (model weights + datasets). Default: $SITE_WORK_DIR/huggingface.
# : "${HF_HOME:=/scratch/$USER/huggingface}"
# The uv environment (~7 GB). Default: <repo>/.venv. Move it if the repo sits on a small home.
# : "${UV_PROJECT_ENVIRONMENT:=/scratch/$USER/vlm_finetuning/venvs/vlm}"
# uv's download cache. Default: uv's own (~/.cache/uv).
# : "${UV_CACHE_DIR:=/scratch/$USER/vlm_finetuning/.uv-cache}"

# Multi-node networking (leave unset to let NCCL auto-detect)
# Interface for NCCL's bootstrap, e.g. an IPoIB interface. Check with `ip -br addr` on a node.
# : "${NCCL_SOCKET_IFNAME:=<interface>}"
# InfiniBand HCA(s) to use. Check with `ibv_devices` on a node.
# : "${NCCL_IB_HCA:=<hca>}"

# Site workarounds
# Disable the Xet download backend, e.g. if it gets OOM-killed on a memory-capped login node.
# : "${HF_HUB_DISABLE_XET:=1}"
